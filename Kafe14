package Jobsheet12;
import java.util.Scanner;

public class Kafe14 {
    public static void Menu(String namaPelanggan, boolean isMember, int jamKunjung) {
        System.out.println("Selamat datang, " + namaPelanggan + "!");
        if (isMember) {
            System.out.println("Anda adalah member, dapatkan diskon 10% untuk setiap pembelian!");
        }
        if (jamKunjung >= 14 && jamKunjung <= 16) {
            System.out.println("Happy Hour! Diskon 20% untuk semua minuman");
        }
        System.out.println("===== MENU RESTO KAFE =====");
        System.out.println("1. Kopi Hitam - Rp 15,000");
        System.out.println("2. Cappuccino - Rp 20,000");
        System.out.println("3. Latte - Rp 22,000");
        System.out.println("4. Teh Tarik - Rp 12,000");
        System.out.println("5. Roti Bakar - Rp 10,000");
        System.out.println("6. Mie Goreng - Rp 18,000");
        System.out.println("===========================");
        System.out.println("Silakan pilih menu yang Anda inginkan.");
    }

    public static int hitungTotalHarga14(int pilihanMenu, int banyakItem) {
        int[] hargaItems = {15000, 20000, 22000, 12000, 10000, 18000};
        int hargaTotal = hargaItems[pilihanMenu - 1] * banyakItem;
        return hargaTotal;
    }

    public static int hitungDiskon(int total, String kodePromo, boolean isMember) {
        double diskonPromo = 0;
        if (kodePromo.equalsIgnoreCase("DISKON50")) {
            diskonPromo = 0.50;
        } else if (kodePromo.equalsIgnoreCase("DISKON30")) {
            diskonPromo = 0.30;
        } else {
            System.out.println("Kode promo invalid");
        }
        double totalDiskon = total * diskonPromo;
        if (isMember) {
            totalDiskon += total * 0.10;
        }
        return (int) totalDiskon;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        System.out.print("Masukkan nama pelanggan: ");
        String nama = sc.nextLine();
        System.out.print("Apakah member (y/n)? ");
        boolean isMember = sc.nextLine().equalsIgnoreCase("y");
        System.out.print("Masukkan jam kunjung (0-23): ");
        int jam = sc.nextInt();
        sc.nextLine();

        Menu(nama, isMember, jam);

        System.out.print("\nMasukkan nomor menu yang ingin Anda pesan: ");
        int pilihanMenu = sc.nextInt();
        System.out.print("Masukkan jumlah item yang ingin dipesan: ");
        int banyakItem = sc.nextInt();
        sc.nextLine();

        int totalBayar = hitungTotalHarga14(pilihanMenu, banyakItem);
        System.out.println("Total harga pesanan: Rp" + totalBayar);

        System.out.print("Masukkan kode promo: ");
        String kodePromo = sc.nextLine();
        
        int nominalDiskon = hitungDiskon(totalBayar, kodePromo, isMember);
        int bayarAkhir = totalBayar - nominalDiskon;
        System.out.println("Besar Diskon: Rp" + nominalDiskon);
        System.out.println("Total yang harus dibayar: Rp" + bayarAkhir);
    }
}
